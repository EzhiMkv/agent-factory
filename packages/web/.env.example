# Скопируй в .env рядом с этим файлом (packages/web/.env). Секретов в шаблоне нет —
# живые значения хранятся только в .env и не попадают в код.

# Адрес контракта Critter в демо-сети Base Sepolia (0x…). Пока не задеплоен —
# сцена показывает милый экран «ждём-ждем деплоя», без криков.
VITE_CRITTER_ADDRESS=

# RPC Base Sepolia для чтения (опционально; без него — публичный RPC viem).
VITE_RPC_URL=

# Приватный ключ burner-аккаунта демо-деплоера (0x…64 hex-символа): с ним-bold у
# кнопок заботы уходят транзакции в Base Sepolia. ТОЛЬКО тестнетовый ключ без
# реальных средств! Никогда не коммитим и не показываем на демо-экране.
VITE_DEMO_KEY=

# Адреса демо-деплоя (печатает script/Deploy.s.sol): ERC-6551 Registry и
# Achievements (ачивки пухлика). Без них карточка кошелька нежно ждёт деплоя.
VITE_REGISTRY_ADDRESS=
VITE_ACHIEVEMENTS_ADDRESS=
