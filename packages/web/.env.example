# Скопируй в .env рядом с этим файлом (packages/web/.env). Секретов здесь нет —
# адрес публичный, ключа ухода появятся в tc-10 и тоже только через .env.

# Адрес контракта Critter в демо-сети Base Sepolia (0x…). Пока не задеплоен —
# сцена показывает милый экран «ждём-ждем деплоя», без криков.
VITE_CRITTER_ADDRESS=

# RPC Base Sepolia для чтения (опционально; без него — публичный RPC viem).
VITE_RPC_URL=
