# Скопируй в .env и заполни себе. Ключи в репозиторий не попадают.

# Деплойер. ТОЛЬКО локальный anvil или testnet; прод-ключей не существует.
DEPLOYER_PRIVATE_KEY=

# RPC-сети демо. Демо-основа — локальная anvil-цепочка.
RPC_URL=http://localhost:8545
BASE_SEPOLIA_RPC_URL=

# Верификация контрактов на Basescan (опционально, для деплоя-бонуса)
BASESCAN_API_KEY=
