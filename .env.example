# Скопируй в .env и заполни себе. Ключи в репозиторий не попадают.

# T-Invest API (read-only токен; торговый токен не использовать)
T_INVEST_TOKEN=
T_INVEST_TPS=5
T_INVEST_ENDPOINT=invest-public-api.tbank.ru:443

# Режим данных: live (T-Invest) | offline (синтетика). Default: live при
# заполненном токене, иначе offline.
DATA_MODE=

# Русский доверенный CA для gRPC (Min Digital Affairs); при отсутствии
# используется системное хранилище grpc-js
T_INVEST_CA_FILE=

# API
PORT=3001

# Postgres (docker compose up db)
DATABASE_URL=postgresql://af:af@localhost:5432/agent_factory

# Judge (другой вендор, не основной кодящий агент)
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
