# Скопируй в .env и заполни себе. Ключи в репозиторий не попадают.

# Демо-сеть — Base Sepolia (тестнет). Ключ деплоя — ТОЛЬКО тестовый,
# без реальных средств; для юнит-тестов Foundry ключей не нужно (anvil).
DEPLOYER_PRIVATE_KEY=

# RPC Base Sepolia (например, endpoints Alchemy/Quicknode)
BASE_SEPOLIA_RPC_URL=

# Верификация контрактов на basescan.org
BASESCAN_API_KEY=

# Локальная сеть для юнит-тестов (не демо): поднимается anvil'ом,
# RPC_URL=http://localhost:8545 — задаётся только локально и не для prod.
ANVIL_RPC_URL=

# Judge-модель — gate перед мержем. ВАЖНО: судья = ДРУГОЙ вендор, чем
# кодящий агент (например: кодит opencode/GLM — судит через OpenRouter
# Claude/GPT). Антропоморфный ключ судьи в репо не попадает.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
