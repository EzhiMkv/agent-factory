{
  "name": "agent-factory-app",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "smoke:tinvest": "pnpm exec tsx --env-file-if-exists=.env scripts/smoke-tinvest.ts"
  },
  "devDependencies": {
    "@af/core": "workspace:*"
  }
}
